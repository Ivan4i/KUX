# Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
POSTGRES_DB=android_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://agent:your_secure_postgres_password_here@postgres:5432/android_agent

# ===========================================
# API Keys and Integrations
# ===========================================

# Notion API
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Puter.js LLM API
PUTER_API_KEY=your_puter_api_key_here

# ===========================================
# Application Settings
# ===========================================
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost,http://localhost:80

# ===========================================
# Notes
# ===========================================
# 1. Never commit the .env file to version control
# 2. Keep your API keys secure
# 3. Use strong passwords for database
# 4. For production, use environment-specific values
# 5. Update CORS_ORIGINS with your actual domain
