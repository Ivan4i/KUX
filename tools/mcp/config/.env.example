# ==============================================================================
# MCP SaaS Gateway - Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your tokens.
# NEVER commit .env.local to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# MCP Configuration
# ------------------------------------------------------------------------------

# Log level for MCP servers (debug, info, warn, error)
MCPLOGLEVEL=info

# Filesystem MCP - root directories (comma-separated)
# Default: current directory and .sandbox
MCPFSROOT=.
MCPFSSANDBOX=.sandbox

# Enable Desktop Commander MCP (default: false)
# WARNING: This gives Claude ability to control your desktop
ENABLEDESKTOPCOMMANDER=false

# Enable Chrome/Browser Control MCP (default: false)
# WARNING: This gives Claude ability to control a browser
ENABLECHROMECONTROL=false

# Puppeteer headless mode (default: true)
PUPPETEERHEADLESS=true

# ------------------------------------------------------------------------------
# GitHub
# ------------------------------------------------------------------------------
# Get token: https://github.com/settings/tokens
# Required scopes: repo (read), read:org
# For fine-grained tokens: Contents (read), Issues (read), Pull requests (read)

GITHUBTOKEN=
GITHUBOWNER=                     # Optional: default org/user for repo listing

# ------------------------------------------------------------------------------
# Figma
# ------------------------------------------------------------------------------
# Get token: https://www.figma.com/developers/api#access-tokens
# Personal Access Token - read-only by default

FIGMATOKEN=
FIGMAFILEKEY=                   # Optional: default file key

# ------------------------------------------------------------------------------
# Cloudflare
# ------------------------------------------------------------------------------
# Get token: https://dash.cloudflare.com/profile/api-tokens
# Create token with "Zone:Read" permission

CLOUDFLAREAPITOKEN=
CLOUDFLAREZONEID=               # Optional: default zone ID or domain name

# ------------------------------------------------------------------------------
# Vercel
# ------------------------------------------------------------------------------
# Get token: https://vercel.com/account/tokens
# Scope: Read-only

VERCELTOKEN=
VERCELTEAMID=                   # Optional: for team projects

# ------------------------------------------------------------------------------
# Notion
# ------------------------------------------------------------------------------
# Create integration: https://www.notion.so/my-integrations
# Capabilities needed: Read content, Read comments
# Share pages/databases with the integration to access them

NOTIONTOKEN=

# ------------------------------------------------------------------------------
# Linear
# ------------------------------------------------------------------------------
# Get token: https://linear.app/settings/api
# Personal API Key - read-only operations

LINEARTOKEN=

# ------------------------------------------------------------------------------
# Sentry
# ------------------------------------------------------------------------------
# Get token: https://sentry.io/settings/account/api/auth-tokens/
# Scopes: project:read, org:read, event:read

SENTRYAUTHTOKEN=
SENTRYORG=                       # Optional: organization slug
SENTRYPROJECT=                   # Optional: project slug

# ------------------------------------------------------------------------------
# Cloudinary
# ------------------------------------------------------------------------------
# Get credentials: https://cloudinary.com/console
# Option 1: Use CLOUDINARYURL (includes all credentials)
# Option 2: Set individual variables

CLOUDINARYURL=                   # Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# OR
CLOUDINARYCLOUDNAME=
CLOUDINARYAPIKEY=
CLOUDINARYAPISECRET=

# ------------------------------------------------------------------------------
# Postman
# ------------------------------------------------------------------------------
# Get API key: https://web.postman.co/settings/me/api-keys
# Name it something like "MCP Gateway (read-only)"

POSTMANAPIKEY=

# ------------------------------------------------------------------------------
# Datadog
# ------------------------------------------------------------------------------
# Get keys: https://app.datadoghq.com/organization-settings/api-keys
# API Key: for sending data
# App Key: https://app.datadoghq.com/organization-settings/application-keys

DATADOGAPIKEY=
DATADOGAPPKEY=
DATADOGSITE=datadoghq.com        # eu1.datadoghq.com for EU, etc.

# ------------------------------------------------------------------------------
# AWS CloudWatch
# ------------------------------------------------------------------------------
# Create IAM user with CloudWatchReadOnlyAccess policy
# https://console.aws.amazon.com/iam/

AWSACCESSKEYID=
AWSSECRETACCESSKEY=
AWSREGION=us-east-1

# ------------------------------------------------------------------------------
# Elasticsearch / ELK
# ------------------------------------------------------------------------------
# Connection URL for your Elasticsearch cluster
# Authentication: either username/password OR API key

ELKURL=                          # e.g., https://my-cluster.es.us-east-1.aws.found.io:9243
ELKUSERNAME=                     # Basic auth username (optional)
ELKPASSWORD=                     # Basic auth password (optional)
ELKAPIKEY=                      # API key (alternative to basic auth)

# ------------------------------------------------------------------------------
# Box (NOT YET IMPLEMENTED - stub service)
# ------------------------------------------------------------------------------
# Create app: https://developer.box.com/console
# Use JWT authentication for server-to-server

BOXCLIENTID=
BOXCLIENTSECRET=
BOXENTERPRISEID=

# ------------------------------------------------------------------------------
# Canva (NOT YET IMPLEMENTED - stub service)
# ------------------------------------------------------------------------------
# Register at: https://www.canva.dev/
# Create Connect API integration

CANVAAPIKEY=
CANVACLIENTID=
CANVACLIENTSECRET=
CANVABRANDID=                   # Optional: default brand

# ------------------------------------------------------------------------------
# Microsoft Clarity (NOT YET IMPLEMENTED - stub service)
# ------------------------------------------------------------------------------
# Dashboard: https://clarity.microsoft.com/
# Note: Limited API access, mainly dashboard/export

CLARITYPROJECTID=
CLARITYAPIKEY=                  # If available
