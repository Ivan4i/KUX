# Notion API
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_whatsapp_outreach_database_id

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id

# LLM via OpenRouter (primary)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.0-flash-exp:free
LLM_VISION_MODEL=google/gemini-2.0-flash-exp:free
LLM_TIMEOUT=60
LLM_CONTEXT_DIR=data/context

# Puter.js LLM API (legacy - fallback)
PUTER_API_KEY=your_puter_api_key_here
PUTER_API_URL=https://api.puter.ai/v1
PUTER_DEFAULT_MODEL=claude-sonnet-4.5

# Database
DATABASE_URL=sqlite:///./data/sqlite.db

# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Device Configuration
DEVICE_CONFIG_PATH=../config/devices.yaml

# ADB / Tailscale
ADB_HOST=localhost
ADB_PORT=5037
